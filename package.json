{
  "name": "@gestaltrun/dsh-github-workbench",
  "description": "GitHub repository, issues, pull requests, Actions and inbox tabs for Gestaltrun Desktop and Web through Better Sidebar.",
  "version": "0.3.0-gestaltrun.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gestaltrun/dsh-github-workbench"
  },
  "homepage": "https://github.com/gestaltrun/dsh-github-workbench",
  "bugs": {
    "url": "https://github.com/gestaltrun/dsh-github-workbench/issues"
  },
  "author": "meyaomiao",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-better-sidebar",
    "github",
    "sidebar",
    "workbench"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@gestaltrun/dsh-better-sidebar"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/gestaltrun-release.mjs"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test \"test/*.test.ts\"",
    "release:pack": "node scripts/gestaltrun-release.mjs pack",
    "release:publish": "node scripts/gestaltrun-release.mjs publish",
    "prepublishOnly": "node scripts/gestaltrun-release.mjs guard",
    "test:release": "node --test test-release/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@gestaltrun/dsh-better-sidebar": "0.19.1-gestaltrun.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tsx": "^4.21.0",
    "yaml": "2.8.2"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@gestaltrun/dsh-better-sidebar": "0.19.1-gestaltrun.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "types": "lib/types/index.d.ts"
}
